NVIDIA_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional compatible-provider key; used only when NVIDIA_API_KEY is unset.
LLM_API_KEY=
# Local defaults to enabled; Vercel requires explicit true; false disables everywhere.
CODEVERSE_ORACLE_ENABLED=
# Optional server-side GitHub token; enables cached public GitHub proxy and branch/release moons.
GITHUB_TOKEN=
